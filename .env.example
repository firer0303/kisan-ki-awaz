# ============================================================
# Kisan Ki Awaz - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your actual API keys.
# NEVER commit your .env file to version control.
# ============================================================

# --- LLM Configuration ---
# OpenAI API key (used as default LLM backend)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Alibaba Cloud DashScope API key (alternative LLM backend)
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-max

# --- Speech Services ---
# Google Cloud Speech-to-Text / Text-to-Speech (supports Urdu, English)
GOOGLE_API_KEY=
GOOGLE_TTS_LANGUAGE_CODE=ur-PK
# Alternative: Microsoft Azure Speech
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# --- Vision / Computer Vision ---
# Hugging Face API token (for loading pretrained models)
HUGGINGFACE_TOKEN=
# Path to custom crop-disease model (if trained locally)
CUSTOM_VISION_MODEL_PATH=
# Alibaba Cloud Vision API (future integration)
ALIBABA_VISION_API_KEY=

# --- Weather API ---
# Pakistan Meteorological Department API (if available)
PMD_API_KEY=
# OpenWeatherMap as fallback
OPENWEATHERMAP_API_KEY=

# --- Market Data ---
# Pakistan Bureau of Statistics / AMIS API (future integration)
MARKET_DATA_API_KEY=
MARKET_DATA_API_URL=

# --- Translation ---
# DeepL API key (alternative translator)
DEEPL_API_KEY=
# LibreTranslate URL (self-hosted option)
LIBRETRANSLATE_URL=

# --- Application Settings ---
APP_ENV=development
APP_DEBUG=true
APP_PORT=8501
APP_HOST=localhost

# --- Database ---
DATABASE_URL=sqlite:///kisan_ki_awaz.db

# --- RAG / Knowledge Base ---
# Path to knowledge base directory
KNOWLEDGE_BASE_DIR=data/knowledge_base
# Embedding model for RAG retrieval
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/kisan_ki_awaz.log
